<%- include('partials/header') %>
    <div class="spread">
        <section class="sheet sheet--grid chapter-copy">
            <h1>Writing</h1>
            <p>Notes on things I’m learning, projects I’m building, and ideas I want to think through on paper.</p>
        </section>
        <section class="sheet chapter-copy writing-page">
            <h2>Entries</h2>
            <% if (entries.length === 0) { %>
                <p>My first entry is still to come.</p>
            <% } else { %>
                <ul class="entry-list">
                    <% for (const post of entries) { %>
                        <li>
                            <time datetime="<%= post.date %>"><%= formatDate(post.date) %></time>
                            <h3><a href="/writing/<%= post.slug %>"><%= post.title %> <span aria-hidden="true">↗</span></a></h3>
                            <p><%= post.summary %></p>
                        </li>
                    <% } %>
                </ul>
            <% } %>
        </section>
    </div>
<%- include('partials/footer') %>
